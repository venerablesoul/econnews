8k.htm"},{"d":"2024-12-02","type":"8-K","title":"Corporate Changes & Voting Matters","url":"https://cdn.yahoofinance.com/prod/sec-filings/0000064803/000119312524268490/d803850d8k.htm"},{"d":"2024-11-21","type":"CORRESP","title":"A correspondence can be sent as a document with another submission type or can be sent as a separate submission","url":"https://cdn.yahoofinance.com/prod/sec-filings/0000064803/000094787124000945/filename1.htm"},{"d":"2024-11-18","type":"8-K","title":"Corporate Changes & Voting Matters","url":"https://cdn.yahoofinance.com/prod/sec-filings/0000064803/000119312524260405/d828431d8k.htm"}],"wiki":{"en":{"t":"CVS Health","x":"CVS Health Corporation is an American multinational healthcare company that owns CVS Pharmacy, a retail pharmacy chain; CVS Caremark, a pharmacy benefits manager; and Aetna, a health insurance provider, among many other brands. The company is the world's second largest healthcare company, behind UnitedHealth Group. In 2023, the company was ranked 64th in the Forbes Global 2000. CVS started in Lowell, Massachusetts by brothers Stanley and Sidney Goldstein and their partner Ralph Hoagland. The name stood for Consumer Value Stores.","url":"https://en.wikipedia.org/wiki/CVS_Health"},"ru":{"t":"CVS Health","x":"CVS Health — американская корпорация, включающая одну из крупнейших в США сетей аптек CVS Pharmacy, страховую компанию Aetna и сеть медицинских центров. Штаб-квартира компании располагается в Вунсокете, штат Род-Айленд.","url":"https://ru.wikipedia.org/wiki/CVS_Health"}},"wiki_at":"2026-11-12T15:42:55.512773+00:00"}