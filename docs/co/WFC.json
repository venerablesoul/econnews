prod/sec-filings/0000072971/000007297125000154/wfc-20250603.htm"},{"d":"2025-05-30","type":"8-K","title":"Corporate Changes & Voting Matters","url":"https://cdn.yahoofinance.com/prod/sec-filings/0000072971/000119312525131510/d938182d8k.htm"}],"wiki":{"en":{"t":"Wells Fargo","x":"Wells Fargo & Company is an American multinational financial services company. The company operates in 35 countries and serves more than 70 million customers worldwide. It is a systemically important financial institution according to the Financial Stability Board, and is considered one of the Big Four banks in the United States, alongside JPMorgan Chase, Bank of America, and Citigroup.","url":"https://en.wikipedia.org/wiki/Wells_Fargo"},"ru":{"t":"Wells Fargo","x":"Wells Fargo & Company, «Уэллс Фарго энд Компани» — банковская холдинговая компания, предоставляющая финансовые и страховые услуги в США, Канаде и Пуэрто-Рико. Входит в так называемую «большую четвёрку» банков США, занимает 7 место в списке самых дорогих компаний США, также входит в рейтинг Fortune 1000. Компания базируется в Сан-Франциско, в то время как штаб-квартира банковского подразделения находится в Су-Фолсе. Основой деятельности является Wells Fargo Bank, на который приходится 89 % активов. С 2011 года входит в число глобально системно значимых банков.","url":"https://ru.wikipedia.org/wiki/Wells_Fargo"}},"wiki_at":"2026-10-15T15:07:01.036638+00:00"}