rl":"https://cdn.yahoofinance.com/prod/sec-filings/0001326801/000132680125000027/meta-20250411.htm"},{"d":"2025-02-20","type":"8-K","title":"Corporate Changes & Voting Matters","url":"https://cdn.yahoofinance.com/prod/sec-filings/0001326801/000132680125000021/meta-20250213.htm"},{"d":"2025-01-30","type":"10-K","title":"Periodic Financial Reports","url":"https://cdn.yahoofinance.com/prod/sec-filings/0001326801/000132680125000017/meta-20241231.htm"},{"d":"2025-01-29","type":"8-K","title":"Corporate Changes & Voting Matters","url":"https://cdn.yahoofinance.com/prod/sec-filings/0001326801/000132680125000014/meta-20250129.htm"},{"d":"2025-01-06","type":"8-K","title":"Corporate Changes & Voting Matters","url":"https://cdn.yahoofinance.com/prod/sec-filings/0001326801/000132680125000005/meta-20241230.htm"},{"d":"2024-10-31","type":"10-Q","title":"Periodic Financial Reports","url":"https://cdn.yahoofinance.com/prod/sec-filings/0001326801/000132680124000081/meta-20240930.htm"}],"wiki":{"en":{"t":"Meta Platforms","x":"Meta Platforms, Inc., headquartered in Menlo Park, California, is an American multinational technology company and is one of the Big Tech companies. Meta owns and operates several prominent social media platforms and communication services, including Facebook, Instagram, WhatsApp, Messenger, and Threads. The company also operates an advertising network for its own sites and third parties; as of 2023, advertising accounted for 97.8% of its total revenue.","url":"https://en.wikipedia.org/wiki/Meta_Platforms"},"ru":{"t":"Meta Platforms","x":"Meta Platforms, Inc. — американская транснациональная холдинговая компания, владеющая технологическим конгломератом и расположенная в Менло-Парке, Калифорния. Является материнской организацией Facebook, Instagram, WhatsApp и Reality Labs. Одна из самых дорогих компаний в мире, а также считается одной из компаний «большой пятёрки» в сфере информационных технологий США, наряду с Amazon, Alphabet, Apple и Microsoft. Практически весь свой доход компания получает за счёт продажи рекламных мест на своих сервисах. Meta Platforms предлагает другие продукты и услуги, включая Facebook Messenger, Facebook Watch и Facebook Portal, также компания приобрела Mapillary, имеет 9,99 % акций в Jio Platforms.","url":"https://ru.wikipedia.org/wiki/Meta_Platforms"}},"wiki_at":"2026-10-22T14:59:40.169206+00:00"}