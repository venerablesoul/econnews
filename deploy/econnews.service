# systemd service: the bot runs continuously and restarts itself after crashes and server reboots.
# Install (on the server, from the econnews folder):
#   sudo cp deploy/econnews.service /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now econnews
# Logs: journalctl -u econnews -f
[Unit]
Description=Economic news bot
After=network-online.target
Wants=network-online.target

[Service]
User=bot
WorkingDirectory=/home/bot/econnews
ExecStart=/usr/bin/python3 -u news_bot.py --loop
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
