TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=123456789
FRED_API_KEY=
PAGES_URL=https://venerablesoul.github.io/econnews/

# how often to check the news in continuous mode (minutes)
INTERVAL_MINUTES=5
# push state.json and the terminal data to GitHub after every run
GIT_SYNC=yes

# other settings — as in .github/workflows/news.yml
MIN_LEVEL=medium
DIGEST_HOUR=21
MORNING_HOUR=9
CHART_HOURS=9,21
# translate headlines into the other language (English ↔ Russian): yes/no
TRANSLATE=yes

# terminal data: company ratios and the earnings calendar (free key from finnhub.io)
FINNHUB_API_KEY=
# US companies, financials, yield curves and rates for the terminal: yes/no
COMPANIES=yes
# optional: AI notes on key stories (key from console.anthropic.com)
ANTHROPIC_API_KEY=
