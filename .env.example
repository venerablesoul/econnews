TELEGRAM_BOT_TOKEN=123456:ABC...
TELEGRAM_CHAT_ID=123456789
FRED_API_KEY=
PAGES_URL=https://venerablesoul.github.io/econnews/

# как часто проверять новости в постоянном режиме (минуты)
INTERVAL_MINUTES=5
# отправлять state.json и данные терминала на GitHub после каждого запуска
GIT_SYNC=yes

# остальные настройки — как в .github/workflows/news.yml
MIN_LEVEL=medium
DIGEST_HOUR=21
MORNING_HOUR=9
CHART_HOURS=9,21

# данные для терминала: мультипликаторы компаний, календарь отчётов (бесплатный ключ finnhub.io)
FINNHUB_API_KEY=
# компании США, отчётность, кривые доходности и ставки для терминала: yes/no
COMPANIES=yes
# необязательно: ИИ-разбор важных новостей (ключ console.anthropic.com)
ANTHROPIC_API_KEY=
